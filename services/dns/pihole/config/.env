# ---------------------------------------------------------------------------- #
#               ------- Pihole Configuration File ------
# ---------------------------------------------------------------------------- #
# https://docs.pi-hole.net/docker/configuration

# Default timezone
TZ=${TIMEZONE}

# User and Group
PIHOLE_UID=${USER_UID}
PIHOLE_GID=${USER_GID}

# ---------------------------------------------------------------------------- #
#               ------- DNS ------
# ---------------------------------------------------------------------------- #
FTLCONF_dns_upstreams=${UNBOUND_DNS_IP}#5335
FTLCONF_dns_listeningmode=ALL

# Reply Host
FTLCONF_dns_reply_host_ipv4=${LOCAL_IP}

# ---------------------------------------------------------------------------- #
#               ------- DNSMASQ ------
# ---------------------------------------------------------------------------- #
DNSMASQ_USER=pihole

# ---------------------------------------------------------------------------- #
#               ------- Webserver ------
# ---------------------------------------------------------------------------- #
FTLCONF_webserver_threads=50

# Interface
FTLCONF_webserver_interface_boxed=false

# API
FTLCONF_webserver_api_password=${PIHOLE_PASSWORD}
FTLCONF_webserver_api_allow_destructive=false
