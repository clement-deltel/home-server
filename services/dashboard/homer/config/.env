
# ---------------------------------------------------------------------------- #
#               ------- Homer Configuration ------
# ---------------------------------------------------------------------------- #
# https://github.com/bastienwirtz/homer/blob/main/README.md#get-started

# default, requires the config directory to be writable for the container user (see user option)
INIT_ASSETS=1

# To host Homer in a subfolder, (ex: http://my-domain/homer), set this to the subfolder path
# SUBFOLDER=

# Internal port of Homer
PORT=8080

# Listen on IPv6
# Set to 1 to disable
IPV6_DISABLE=0
