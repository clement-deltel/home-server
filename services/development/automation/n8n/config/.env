# ---------------------------------------------------------------------------- #
#               ------- n8n Configuration --------
# ---------------------------------------------------------------------------- #
# https://docs.n8n.io/hosting/configuration/environment-variables/

# ---------------------------------------------------------------------------- #
#               ------- General --------
# ---------------------------------------------------------------------------- #

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_UNVERIFIED_PACKAGES_ENABLED=false

NODE_ENV=production

GENERIC_TIMEZONE=UTC
TZ=UTC

# ---------------------------------------------------------------------------- #
#               ------- Compression --------
# ---------------------------------------------------------------------------- #

N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=256000
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000

# ---------------------------------------------------------------------------- #
#               ------- Database --------
# ---------------------------------------------------------------------------- #

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=${N8N_DB_USERNAME}
DB_POSTGRESDB_PASSWORD=${N8N_DB_PASSWORD}
DB_POSTGRESDB_SCHEMA=public

# ---------------------------------------------------------------------------- #
#               ------- Proxy --------
# ---------------------------------------------------------------------------- #

N8N_PROXY_HOPS=1

# ---------------------------------------------------------------------------- #
#               ------- Runners --------
# ---------------------------------------------------------------------------- #

N8N_RUNNERS_MODE=external
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_AUTH_TOKEN=${N8N_RUNNERS_AUTH_TOKEN}

N8N_RUNNERS_TASK_TIMEOUT=60

N8N_NATIVE_PYTHON_RUNNER=true

# ---------------------------------------------------------------------------- #
#               ------- Security --------
# ---------------------------------------------------------------------------- #

N8N_MFA_ENABLED=true

# ---------------------------------------------------------------------------- #
#               ------- SMTP --------
# ---------------------------------------------------------------------------- #

N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=${SMTP_HOST}
N8N_SMTP_PORT=${SMTP_PORT}
N8N_SMTP_USER=${SMTP_USERNAME}
N8N_SMTP_PASS=${SMTP_PASSWORD}
N8N_SMTP_SENDER=noreply-n8n@${DOMAIN}
N8N_SMTP_SSL=false
N8N_SMTP_STARTTLS=true

# ---------------------------------------------------------------------------- #
#               ------- Web --------
# ---------------------------------------------------------------------------- #

N8N_PROTOCOL=https
N8N_HOST=${N8N_HOST}
N8N_PORT=5678

N8N_WEBHOOK_URL=https://${N8N_HOST}
