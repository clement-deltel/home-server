# ---------------------------------------------------------------------------- #
#               ------- OpenGym Web Configuration --------
# ---------------------------------------------------------------------------- #

NGINX_PORT=80
BACKEND=api
PORT=3000

# Docker's embedded DNS. Only ever needs changing on a runtime that is not Docker.
RESOLVER=127.0.0.11

# Empty drops the CF-Connecting-IP header, so a direct client cannot forge the address
# the activity log records. Cloudflare users set CF_CONNECTING_IP='$http_cf_connecting_ip'
# in .env, single quotes included, or Compose expands it to an empty string.
CF_CONNECTING_IP=

# Subpath deployments behind a proxy that passes its prefix through ("/gym", no trailing
# slash). Empty serves the app at the site root, which is what it has always done; a
# proxy that strips the prefix needs nothing set (docs/SELF_HOSTING.md §5).
BASE_PATH=

# The largest photo or video upload nginx passes to the API. Keep it above
# MEDIA_VIDEO_MAX_MB (100 by default), which the api service reads from .env.
MEDIA_UPLOAD_MAX=112m

# Where /mcp goes (docs/MCP_REMOTE.md). Resolved per request like /api, so a stack without
# the mcp service starts fine and /mcp answers that it is off.
MCP_BACKEND=mcp
MCP_PORT=3100
