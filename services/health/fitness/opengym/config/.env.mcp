# ---------------------------------------------------------------------------- #
#               ------- OpenGym MCP Configuration --------
# ---------------------------------------------------------------------------- #

MCP_PORT=3100
OPENGYM_API_URL=http://api:3000

# The app's address, so a browser page from anywhere else is turned away (DNS rebinding).
ORIGIN=https://${OPENGYM_HOST}

# The prefix under a subpath deployment, for the sign-in pointer its 401 carries.
BASE_PATH=
