# ---------------------------------------------------------------------------- #
#               ------ CrowdSec WebUI Configuration -------
# ---------------------------------------------------------------------------- #
# https://github.com/TheDuffman85/crowdsec-web-ui#configuration
#
# Every setting maps to a YAML field in /app/data/config.yaml. Format: CONFIG_<SECTION>_<FIELD>=value
# - Values are parsed as YAML and validated. Whole sections accept YAML via CONFIG_SERVER, CONFIG_STORAGE,
#   CONFIG_UI, CONFIG_AUTH, CONFIG_NOTIFICATIONS, CONFIG_AUDIT, CONFIG_UPDATES, CONFIG_CROWDSEC, CONFIG_INSTANCES.
# - Arrays use zero-based contiguous indexes (e.g. CONFIG_AUTH_OIDC_ADMIN_GROUPS_0) or a YAML list.
# - Secrets also accept a _FILE suffix (e.g. CONFIG_AUTH_SESSION_SECRET_FILE=/run/secrets/...).
# - CONFIG_* values override config.yaml in memory; a restart is required after any change.
# - Uncommented values below are the documented defaults, except for the instance connection.
#   Settings managed in the UI (refresh interval, manual refresh, password login, OIDC) are left commented:
#   setting them here locks them in Settings.

# ---------------------------------------------------------------------------- #
#               ------ General ------
# ---------------------------------------------------------------------------- #
# Select another existing config file (default: /app/data/config.yaml).
# CONFIG_FILE=/app/data/config.yaml

# Write validated merged CONFIG_* values back into config.yaml on every start.
CONFIG_PERSIST_OVERRIDES=false


# ---------------------------------------------------------------------------- #
#               ------ Server ------
# ---------------------------------------------------------------------------- #
# HTTP listen port.
CONFIG_SERVER_PORT=3000

# Optional URL prefix such as /crowdsec (no trailing slash).
# CONFIG_SERVER_BASE_PATH=

# Hostname this installation identifies itself with to remote services (SMTP EHLO). Not a listen address. Default: localhost.
# CONFIG_SERVER_HOSTNAME=${CROWDSEC_WEBUI_HOST}


# ---------------------------------------------------------------------------- #
#               ------ Storage ------
# ---------------------------------------------------------------------------- #
# Location of state.db (users, passkeys, notification channels, saved filters, UI settings). Back it up.
CONFIG_STORAGE_DATA_DIR=/app/data

# Location of cache.db (rebuilt from LAPI if lost). Defaults to the data dir.
# CONFIG_STORAGE_CACHE_DIR=/app/data

# Local GeoNames snapshot used for location labels.
CONFIG_STORAGE_GEONAMES_DIR=/app/geonames

# SQLite write-ahead logging for cache.db. Set to false for filesystems without WAL support.
CONFIG_STORAGE_WAL_ENABLED=true

# Bounded incremental vacuum while idle. Applies when cache.db is created.
CONFIG_STORAGE_INCREMENTAL_VACUUM_ENABLED=true

# Retained WAL size after checkpoints; 'unlimited' disables trimming. Ignored when WAL is disabled.
CONFIG_STORAGE_JOURNAL_SIZE_LIMIT=128MiB

# Maximum execution time for regular database queries.
CONFIG_STORAGE_QUERY_TIMEOUT=30s

# Maximum execution time for dashboard statistics queries.
CONFIG_STORAGE_ANALYTICS_QUERY_TIMEOUT=60s


# ---------------------------------------------------------------------------- #
#               ------ UI ------
# ---------------------------------------------------------------------------- #
# Browser timezone or an IANA zone such as Europe/Paris or UTC.
CONFIG_UI_TIME_ZONE=browser

# Clock format. Allowed values: [browser, 12h, 24h].
CONFIG_UI_TIME_FORMAT=browser

# Browser date format or custom pattern (dd/mm/yyyy, mm/dd/yyyy, yyyy-MM-dd; words quoted with single quotes).
CONFIG_UI_DATE_FORMAT=browser

# Hide management actions and reject mutating API operations.
CONFIG_UI_READ_ONLY=false

# Show the Allowlists sidebar link. Omit to let each user choose in Settings > Profile.
CONFIG_UI_ALLOWLISTS_SIDEBAR_VISIBLE=true

# Show the Metrics sidebar link. Omit to let each user choose in Settings > Profile.
CONFIG_UI_METRICS_SIDEBAR_VISIBLE=true


# ---------------------------------------------------------------------------- #
#               ------ Updates ------
# ---------------------------------------------------------------------------- #
# Enable the built-in update check.
CONFIG_UPDATES_ENABLED=true


# ---------------------------------------------------------------------------- #
#               ------ Authentication ------
# ---------------------------------------------------------------------------- #
# Enable authentication. Allowed values: [auto, true, false]; auto enables it for new databases.
CONFIG_AUTH_ENABLED=auto

# Signs sessions and encrypts saved authentication settings. Default: generated and stored.
# Generate with: openssl rand -base64 48
# CONFIG_AUTH_SESSION_SECRET=${CROWDSEC_WEBUI_SESSION_SECRET}

# Encrypts stored per-account TOTP seeds. Default: the session secret.
# Generate with: openssl rand -base64 48
# CONFIG_AUTH_TOTP_SECRET=${CROWDSEC_WEBUI_TOTP_SECRET}

# Optional base32 fallback TOTP seed for the password user (minimum 26 characters).
# CONFIG_AUTH_TOTP_SEED=${CROWDSEC_WEBUI_TOTP_SEED}

# Enable/disable password login and lock the Settings toggle. Default: unset (managed in Settings).
# CONFIG_AUTH_PASSWORD_LOGIN_ENABLED=true


# ---------------------------------------------------------------------------- #
#               ------ Authentication - OIDC ------
# ---------------------------------------------------------------------------- #
# OIDC provider issuer URL.
# CONFIG_AUTH_OIDC_ISSUER_URL=

# OIDC client identifier (parsed as a string; numeric IDs keep all digits).
# CONFIG_AUTH_OIDC_CLIENT_ID=

# OIDC client secret.
# CONFIG_AUTH_OIDC_CLIENT_SECRET=${CROWDSEC_WEBUI_OIDC_CLIENT_SECRET}

# Requested OIDC scopes; must include openid.
# CONFIG_AUTH_OIDC_SCOPE=openid profile email

# Claim containing role-mapping groups.
# CONFIG_AUTH_OIDC_GROUPS_CLAIM=groups

# Groups granted administrator access (YAML array or indexed, even for one group).
# CONFIG_AUTH_OIDC_ADMIN_GROUPS=[]

# Groups granted read-only access (YAML array or indexed, even for one group).
# CONFIG_AUTH_OIDC_READ_ONLY_GROUPS=[]

# Role for unmatched OIDC users. Allowed values: [deny, admin, read-only].
# CONFIG_AUTH_OIDC_UNMATCHED_ROLE=deny

# Also end the identity provider session on logout (RP-initiated logout).
# CONFIG_AUTH_OIDC_END_SESSION=false

# Accept back-channel logout notifications from the identity provider.
# CONFIG_AUTH_OIDC_BACKCHANNEL_LOGOUT=false

# Redirect the login page straight to the IdP (only while OIDC is configured and password login is disabled).
# CONFIG_AUTH_OIDC_AUTO_LOGIN=false

# Link SSO sign-ins to existing local accounts with the same username.
# CONFIG_AUTH_OIDC_AUTO_LINK_USERNAME=false


# ---------------------------------------------------------------------------- #
#               ------ Notifications ------
# ---------------------------------------------------------------------------- #
# Encrypts saved notification credentials. Default: generated and stored.
# Generate with: openssl rand -base64 48
# CONFIG_NOTIFICATIONS_SECRET_KEY=${CROWDSEC_WEBUI_NOTIFICATIONS_SECRET_KEY}

# Allow private, loopback and link-local notification destinations.
CONFIG_NOTIFICATIONS_ALLOW_PRIVATE_ADDRESSES=true

# Log truncated rendered payloads after failed notification delivery.
CONFIG_NOTIFICATIONS_DEBUG_PAYLOADS=false


# ---------------------------------------------------------------------------- #
#               ------ Audit ------
# ---------------------------------------------------------------------------- #
# Write audit entries for user actions to the application log.
CONFIG_AUDIT_ENABLED=true

# Also append audit entries as JSON lines to this file.
# CONFIG_AUDIT_LOG_FILE=/app/data/audit.log


# ---------------------------------------------------------------------------- #
#               ------ CrowdSec - Alert Handling ------
# ---------------------------------------------------------------------------- #
# Include simulation-mode alerts and decisions.
CONFIG_CROWDSEC_SIMULATIONS_ENABLED=false

# Omitting alertFilters uses the standard non-CAPI feed; setting any filter field enables explicit filtering.
# Keep these commented unless explicit filtering is wanted.
# Keep alerts matching these exact origins.
# CONFIG_CROWDSEC_ALERT_FILTERS_INCLUDE_ORIGINS=[]
# Drop alerts matching these exact origins.
# CONFIG_CROWDSEC_ALERT_FILTERS_EXCLUDE_ORIGINS=[]
# Add the Central API / community-blocklist feed.
# CONFIG_CROWDSEC_ALERT_FILTERS_INCLUDE_CAPI=false
# Keep empty-origin alerts with explicit include filters.
# CONFIG_CROWDSEC_ALERT_FILTERS_INCLUDE_ORIGIN_EMPTY=false
# Drop alerts whose effective origin is empty.
# CONFIG_CROWDSEC_ALERT_FILTERS_EXCLUDE_ORIGIN_EMPTY=false
# Compatibility origin allowlist; CAPI enables the CAPI feed.
# CONFIG_CROWDSEC_ALERT_FILTERS_LEGACY_ORIGINS=[]
# Compatibility list of additional scenarios.
# CONFIG_CROWDSEC_ALERT_FILTERS_LEGACY_EXTRA_SCENARIOS=[]

# ---------------------------------------------------------------------------- #
#               ------ CrowdSec - Manual Decisions ------
# ---------------------------------------------------------------------------- #
# Additional author/name scenarios offered by the Add Decision form (manual/web-ui is always offered).
# CONFIG_CROWDSEC_MANUAL_DECISIONS_SCENARIOS=[]


# ---------------------------------------------------------------------------- #
#               ------ CrowdSec - Synchronization ------
# ---------------------------------------------------------------------------- #
# Durations accept ms, s, m, h, d. The lookback field accepts only m, h, d.
# Imported history and retention window.
CONFIG_CROWDSEC_SYNC_LOOKBACK=168h
# Active refresh cadence; 0 or manual disables scheduling. Setting it locks the Settings value.
# CONFIG_CROWDSEC_SYNC_REFRESH_INTERVAL=1m
# Enable manual refresh controls. Setting it locks the Settings value.
# CONFIG_CROWDSEC_SYNC_MANUAL_REFRESH_ENABLED=false
# Refresh cadence while the application is idle; 0 disables it.
CONFIG_CROWDSEC_SYNC_IDLE_REFRESH_INTERVAL=10m
# Inactivity before idle refresh behavior begins.
CONFIG_CROWDSEC_SYNC_IDLE_THRESHOLD=2m
# Timeout for individual LAPI requests.
CONFIG_CROWDSEC_SYNC_REQUEST_TIMEOUT=30s
# Grace period before deleting alerts owned by expired decisions.
CONFIG_CROWDSEC_SYNC_BOUNCER_PROPAGATION_DELAY=15s
# Stop retrying failed queued deletions after this age; 0 disables the limit.
CONFIG_CROWDSEC_SYNC_DELETION_QUEUE_MAX_AGE=24h
# Default timeout for metrics endpoints.
CONFIG_CROWDSEC_SYNC_METRICS_REQUEST_TIMEOUT=5s
# CrowdSec machine heartbeat cadence; 0 disables it.
CONFIG_CROWDSEC_SYNC_HEARTBEAT_INTERVAL=30s
# Historical import window size.
CONFIG_CROWDSEC_SYNC_ALERT_SYNC_CHUNK=12h
# Minimum retry window after a timed-out import.
CONFIG_CROWDSEC_SYNC_ALERT_SYNC_MIN_CHUNK=15m
# Fixed alert-history reconciliation window size.
CONFIG_CROWDSEC_SYNC_RECONCILE_WINDOW=1h
# Boundary between recent and older reconciliation windows.
CONFIG_CROWDSEC_SYNC_RECONCILE_RECENT_AGE=24h
# Reconciliation cadence for recent windows.
CONFIG_CROWDSEC_SYNC_RECONCILE_RECENT_INTERVAL=15m
# Reconciliation cadence for windows with active decisions.
CONFIG_CROWDSEC_SYNC_RECONCILE_ACTIVE_INTERVAL=5m
# Reconciliation cadence for older windows.
CONFIG_CROWDSEC_SYNC_RECONCILE_OLD_INTERVAL=3h
# Maximum due windows processed per refresh.
CONFIG_CROWDSEC_SYNC_RECONCILE_WINDOWS_PER_REFRESH=2
# Delay between failed initial-sync retries; 0 retries immediately.
CONFIG_CROWDSEC_SYNC_BOOTSTRAP_RETRY_DELAY=30s
# Background retry after initial synchronization failure.
CONFIG_CROWDSEC_SYNC_BOOTSTRAP_RETRY_ENABLED=true

# ---------------------------------------------------------------------------- #
#               ------ Instance 0 - LAPI ------
# ---------------------------------------------------------------------------- #
# CONFIG_INSTANCE_* addresses instance 0 (same as CONFIG_INSTANCES_0_*). Do not set both forms together.
# Use CONFIG_INSTANCES_<INDEX>_* for additional instances (indexes must be contiguous).
# Configure exactly one credential shape: password (username + password) or mTLS (certFile + keyFile).

# CrowdSec LAPI base URL (no credentials, path or fragment).
CONFIG_INSTANCE_LAPI_URL=http://crowdsec:8080

# For local CrowdSec instances
# CONFIG_INSTANCE_LAPI_URL=http://host.docker.internal:8080

# Stable database identity (lowercase letters, digits, _ and -). Default: instance index. Keep stable once data is imported.
# CONFIG_INSTANCE_ID=0
# Unique display name. Default: Instance 0.
# CONFIG_INSTANCE_NAME=Instance 0
# Optional short text or emoji shown in the instance selector.
# CONFIG_INSTANCE_ICON=
# LAPI authentication mode. Allowed values: [none, password, mtls]; inferred from credentials when unset.
# CONFIG_INSTANCE_LAPI_AUTH_TYPE=password
# CrowdSec machine username (password auth).
CONFIG_INSTANCE_LAPI_AUTH_USERNAME=${CROWDSEC_WEBUI_USERNAME}

# CrowdSec machine password (password auth). Also supports CONFIG_INSTANCE_LAPI_AUTH_PASSWORD_FILE.
CONFIG_INSTANCE_LAPI_AUTH_PASSWORD=${CROWDSEC_WEBUI_PASSWORD}

# Client certificate path (mTLS auth).
# CONFIG_INSTANCE_LAPI_AUTH_CERT_FILE=
# Client private-key path (mTLS auth).
# CONFIG_INSTANCE_LAPI_AUTH_KEY_FILE=
# CA bundle used to verify the LAPI server.
# CONFIG_INSTANCE_LAPI_TLS_CA_FILE=
# Per-instance manual decision scenarios (YAML list only); replaces the global list, [] offers only manual/web-ui.
# CONFIG_INSTANCE_MANUAL_DECISIONS_SCENARIOS=[]

# ---------------------------------------------------------------------------- #
#               ------ Instance 0 - Metrics Endpoint ------
# ---------------------------------------------------------------------------- #
# Zero or more Prometheus endpoints. Metrics index 0 may be omitted (CONFIG_INSTANCE_METRICS_URL).
# For CrowdSec: http://crowdsec:6060/metrics
# Absolute HTTP(S) Prometheus endpoint URL (required if a metrics endpoint is defined).
CONFIG_INSTANCE_METRICS_URL=http://crowdsec:6060/metrics
# Stable identifier unique within the instance. Default: metrics index.
# CONFIG_INSTANCE_METRICS_ID=0
# Display name. Default: Metrics 0.
# CONFIG_INSTANCE_METRICS_NAME=Metrics 0
# Optional short text or emoji icon.
# CONFIG_INSTANCE_METRICS_ICON=
# Request timeout for this endpoint. Default: global metricsRequestTimeout (5s).
# CONFIG_INSTANCE_METRICS_REQUEST_TIMEOUT=5s
# Metrics authentication mode. Allowed values: [none, basic, bearer].
# CONFIG_INSTANCE_METRICS_AUTH_TYPE=none
# Basic-auth username.
# CONFIG_INSTANCE_METRICS_AUTH_USERNAME=
# Basic-auth password. Also supports CONFIG_INSTANCE_METRICS_AUTH_PASSWORD_FILE.
# CONFIG_INSTANCE_METRICS_AUTH_PASSWORD=${CROWDSEC_WEBUI_METRICS_PASSWORD}
# Bearer token. Also supports CONFIG_INSTANCE_METRICS_AUTH_TOKEN_FILE.
# CONFIG_INSTANCE_METRICS_AUTH_TOKEN=${CROWDSEC_WEBUI_METRICS_TOKEN}
# CA bundle used to verify the metrics server.
# CONFIG_INSTANCE_METRICS_TLS_CA_FILE=
# Metrics client certificate (requires key file).
# CONFIG_INSTANCE_METRICS_TLS_CERT_FILE=
# Metrics client private key (requires cert file).
# CONFIG_INSTANCE_METRICS_TLS_KEY_FILE=

# ---------------------------------------------------------------------------- #
#               ------ Instance 0 - Synchronization Overrides ------
# ---------------------------------------------------------------------------- #
# Each field inherits the matching CONFIG_CROWDSEC_SYNC_* value when omitted; set only to override for instance 0.
# History and retention window. Inherits the global value.
# CONFIG_INSTANCE_SYNC_LOOKBACK=168h
# Active refresh cadence. Inherits the global value.
# CONFIG_INSTANCE_SYNC_REFRESH_INTERVAL=1m
# Idle refresh cadence. Inherits the global value.
# CONFIG_INSTANCE_SYNC_IDLE_REFRESH_INTERVAL=10m
# Time before the instance is considered idle. Inherits the global value.
# CONFIG_INSTANCE_SYNC_IDLE_THRESHOLD=2m
# LAPI request timeout. Inherits the global value.
# CONFIG_INSTANCE_SYNC_REQUEST_TIMEOUT=30s
# Machine heartbeat cadence. Inherits the global value.
# CONFIG_INSTANCE_SYNC_HEARTBEAT_INTERVAL=30s
# Historical import window size. Inherits the global value.
# CONFIG_INSTANCE_SYNC_ALERT_SYNC_CHUNK=12h
# Minimum retry window. Inherits the global value.
# CONFIG_INSTANCE_SYNC_ALERT_SYNC_MIN_CHUNK=15m
# Reconciliation window size. Inherits the global value.
# CONFIG_INSTANCE_SYNC_RECONCILE_WINDOW=1h
# Recent-window age boundary. Inherits the global value.
# CONFIG_INSTANCE_SYNC_RECONCILE_RECENT_AGE=24h
# Recent-window reconciliation cadence. Inherits the global value.
# CONFIG_INSTANCE_SYNC_RECONCILE_RECENT_INTERVAL=15m
# Active-decision reconciliation cadence. Inherits the global value.
# CONFIG_INSTANCE_SYNC_RECONCILE_ACTIVE_INTERVAL=5m
# Older-window reconciliation cadence. Inherits the global value.
# CONFIG_INSTANCE_SYNC_RECONCILE_OLD_INTERVAL=3h
# Due-window budget per refresh. Inherits the global value.
# CONFIG_INSTANCE_SYNC_RECONCILE_WINDOWS_PER_REFRESH=2
# Initial-sync retry delay. Inherits the global value.
# CONFIG_INSTANCE_SYNC_BOOTSTRAP_RETRY_DELAY=30s
# Background initial-sync retry. Inherits the global value.
# CONFIG_INSTANCE_SYNC_BOOTSTRAP_RETRY_ENABLED=true
# Alert-deletion grace period. Inherits the global value.
# CONFIG_INSTANCE_SYNC_BOUNCER_PROPAGATION_DELAY=15s
