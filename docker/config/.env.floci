# ---------------------------------------------------------------------------- #
#               ------- Floci Configuration ------
# ---------------------------------------------------------------------------- #
# https://github.com/floci-io/floci#configuration

FLOCI_PORT=4566
FLOCI_DEFAULT_REGION=us-east-2
FLOCI_DEFAULT_ACCOUNT_ID=000000000000

FLOCI_STORAGE_MODE=memory
FLOCI_STORAGE_PERSISTENT_PATH=./data

FLOCI_SERVICES_LAMBDA_ECR_BASE_URI=public.ecr.aws
FLOCI_SERVICES_S3_ENFORCE_AUTH=false

# ---------------------------------------------------------------------------- #
#               ------- Images ------
# ---------------------------------------------------------------------------- #
# https://github.com/floci-io/floci#overriding-default-images

FLOCI_SERVICES_ELASTICACHE_DEFAULT_IMAGE=valkey/valkey:9.1.2

FLOCI_SERVICES_RDS_DEFAULT_POSTGRES_IMAGE=postgres:18-alpine
FLOCI_SERVICES_MWAA_DEFAULT_POSTGRES_IMAGE=postgres:18-alpine

# ---------------------------------------------------------------------------- #
#               ------- UI ------
# ---------------------------------------------------------------------------- #
# https://github.com/floci-io/floci#web-console

FLOCI_SERVICES_UI_ENABLED=true

FLOCI_SERVICES_UI_IMAGE=floci/floci-ui:0.7.0
FLOCI_SERVICES_UI_CONTAINER_NAME=floci-ui

FLOCI_SERVICES_UI_PORT=4500
FLOCI_SERVICES_UI_INTERNAL_PORT=4500

# FLOCI_SERVICES_UI_BIND_ADDRESS=
FLOCI_SERVICES_UI_KEEP_RUNNING_ON_SHUTDOWN=false
